<div
  data-controller="l-ui--panel-resize l-ui--panel"
  data-action="keydown.esc@window->l-ui--panel#handleEscape l-ui--panel-resize:widthChanged->l-ui--panel#updatePageMargin l-ui--panel-button:toggle->l-ui--panel#toggle"
>
  <aside
    id="panel"
    class="l-ui-container--panel"
    data-l-ui--panel-target="container"
    data-l-ui--panel-resize-target="container"
    aria-label="Side panel"
    aria-hidden="true"
    inert
  >
    <div
      class="l-ui-panel__resize-handle"
      role="separator"
      aria-label="Resize panel"
      aria-orientation="vertical"
      aria-valuenow="480"
      aria-valuemin="240"
      tabindex="0"
      data-l-ui--panel-resize-target="handle"
      data-action="mousedown->l-ui--panel-resize#startResize dblclick->l-ui--panel-resize#resetWidth keydown->l-ui--panel-resize#handleKeydown"
    ></div>

    <div class="l-ui-panel">
      <div class="l-ui-panel__header">
        <div class="l-ui-panel__header-content">
          <div class="l-ui-panel__header-buttons">
            <div class="l-ui-panel__header-heading">
              <%= yield :l_ui_panel_heading %>
            </div>

            <div class="l-ui-panel__header-actions">
              <button type="button"
                class="l-ui-button--icon l-ui-button--panel-close"
                aria-label="Hide panel"
                aria-controls="panel"
                title="Toggle panel (Ctrl+i / ⌘i)"
                data-action="click->l-ui--panel#toggle"
                data-l-ui--panel-target="hideButton">
                <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18l6-6-6-6"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="l-ui-panel__body">
        <%= yield :l_ui_panel_body %>
      </div>
    </div>
  </aside>

  <button
    type="button"
    class="l-ui-panel__button"
    aria-label="Open panel"
    aria-expanded="false"
    aria-controls="panel"
    aria-keyshortcuts="Control+I Meta+I Control+Alt+1 Meta+Alt+1 Control+Alt+2 Meta+Alt+2 Control+Alt+3 Meta+Alt+3 Control+Alt+4 Meta+Alt+4"
    tabindex="-1"
    title="Toggle panel (Ctrl/⌘+i). Move to corners (Ctrl/⌘ + Alt/⌥ + 1/2/3/4), double-click, or drag."
    data-controller="l-ui--panel-button"
    data-action="click->l-ui--panel-button#queueToggle dblclick->l-ui--panel-button#cycleCorner mousedown->l-ui--panel-button#startDrag touchstart:passive->l-ui--panel-button#startDrag"
    data-l-ui--panel-target="actionButton"
  >
    <%= image_tag("layered_ui/panel_icon_light.svg", alt: "Panel icon for light theme", class: "l-ui-icon--lg l-ui-panel__icon--light", aria: { hidden: true }) %>
    <%= image_tag("layered_ui/panel_icon_dark.svg", alt: "Panel icon for dark theme", class: "l-ui-icon--lg l-ui-panel__icon--dark", aria: { hidden: true }) %>
  </button>
</div>
