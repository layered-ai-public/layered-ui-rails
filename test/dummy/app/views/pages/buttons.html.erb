<h1>Buttons</h1>

<p class="l-ui-utility--mt-md">Button styles for primary actions, secondary actions, and destructive operations.</p>

<h2 class="l-ui-utility--mt-2xl">Button variants</h2>

<div class="l-ui-container--spread l-ui-utility--mt-lg">
  <button class="l-ui-button--primary">Primary button</button>
  <button class="l-ui-button--outline">Outline button</button>
  <button class="l-ui-button--outline-danger">Danger button</button>
  <button class="l-ui-button--icon" aria-label="Close">
    <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
  </button>
  <button class="l-ui-button--icon" aria-label="Toggle dark mode">
    <%= image_tag "layered_ui/icon_moon.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
  </button>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-variants-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-variants-heading">Button variants</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;button class="l-ui-button--primary"&gt;Primary&lt;/button&gt;
&lt;button class="l-ui-button--outline"&gt;Outline&lt;/button&gt;
&lt;button class="l-ui-button--outline-danger"&gt;Danger&lt;/button&gt;
&lt;button class="l-ui-button--icon" aria-label="Close"&gt;
  &lt;svg class="l-ui-icon--sm"&gt;...&lt;/svg&gt;
&lt;/button&gt;
&lt;button class="l-ui-button--icon" aria-label="Toggle dark mode"&gt;
  &lt;svg class="l-ui-icon--sm"&gt;...&lt;/svg&gt;
&lt;/button&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">Full width</h2>

<div class="l-ui-utility--mt-lg">
  <button class="l-ui-button--primary l-ui-button--full">Full width button</button>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-full-width-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-full-width-heading">Full width</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;button class="l-ui-button--primary l-ui-button--full"&gt;
  Full width button
&lt;/button&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Button CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-button--primary</code></th>
        <td class="l-ui-table__cell">Primary action button with solid background</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-button--outline</code></th>
        <td class="l-ui-table__cell">Secondary action button with outline style</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-button--outline-danger</code></th>
        <td class="l-ui-table__cell">Destructive action button with red outline</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-button--icon</code></th>
        <td class="l-ui-table__cell">Icon-only button for close, theme toggle, and other actions</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-button--full</code></th>
        <td class="l-ui-table__cell">Modifier for full-width button</td>
      </tr>
    </tbody>
  </table>
</div>
