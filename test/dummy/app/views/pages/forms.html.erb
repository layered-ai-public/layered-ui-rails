<%= l_ui_title_bar(
  title: "Forms",
  breadcrumbs: [
    ["Home", root_path]
  ]
) %>

<p class="l-ui-mt-md">Form styles with accessible labels, inputs, and validation states.</p>

<h2 class="l-ui-mt-2xl">Example form</h2>

<form class="l-ui-form l-ui-mt-lg" action="#" method="post">
  <div class="l-ui-form__group">
    <label class="l-ui-label" for="name">
      Full name
      <span class="l-ui-form__required" aria-hidden="true">*</span>
      <span class="l-ui-sr-only">(required)</span>
    </label>
    <input type="text" id="name" name="name" class="l-ui-form__field" placeholder="Enter your full name" required autocomplete="name">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="email">
      Email address
      <span class="l-ui-form__required" aria-hidden="true">*</span>
      <span class="l-ui-sr-only">(required)</span>
    </label>
    <input type="email" id="email" name="email" class="l-ui-form__field" placeholder="you@example.com" required autocomplete="email">
    <div class="l-ui-form__hint">
      We'll never share your email with anyone else.
    </div>
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="role">
      Role
      <span class="l-ui-form__required" aria-hidden="true">*</span>
      <span class="l-ui-sr-only">(required)</span>
    </label>
    <div class="l-ui-select-wrapper">
      <select id="role" name="role" class="l-ui-select" required>
        <option value="">Select a role</option>
        <option value="admin">Admin</option>
        <option value="editor">Editor</option>
        <option value="viewer">Viewer</option>
      </select>
    </div>
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="bio">
      Bio
    </label>
    <textarea id="bio" name="bio" class="l-ui-form__field" rows="4" placeholder="Tell us a little about yourself"></textarea>
    <div class="l-ui-form__hint">
      Optional: A brief description of yourself.
    </div>
  </div>

  <div class="l-ui-form__actions">
    <button type="submit" class="l-ui-button--primary">
      Submit
    </button>
  </div>
</form>

<div class="l-ui-mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-forms-form-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-forms-form-heading">Form</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;form class="l-ui-form"&gt;
  &lt;div class="l-ui-form__group"&gt;
    &lt;label class="l-ui-label" for="name"&gt;
      Full name
      &lt;span class="l-ui-form__required"&gt;*&lt;/span&gt;
    &lt;/label&gt;
    &lt;input type="text" class="l-ui-form__field"&gt;
  &lt;/div&gt;

  &lt;div class="l-ui-form__group"&gt;
    &lt;label class="l-ui-label" for="role"&gt;Role&lt;/label&gt;
    &lt;div class="l-ui-select-wrapper"&gt;
      &lt;select class="l-ui-select"&gt;
        &lt;option value=""&gt;Select a role&lt;/option&gt;
      &lt;/select&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;div class="l-ui-form__actions"&gt;
    &lt;button type="submit" class="l-ui-button--primary"&gt;
      Submit
    &lt;/button&gt;
  &lt;/div&gt;
&lt;/form&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-mt-2xl">Checkbox inputs</h2>

<div class="l-ui-form__group l-ui-mt-lg">
  <label class="l-ui-label">Preferences</label>
  <div class="l-ui-checkbox-container l-ui-mt-lg">
    <input type="checkbox" id="newsletter" name="newsletter" value="1" checked>
    <label class="l-ui-label--checkbox" for="newsletter">Subscribe to newsletter</label>
  </div>
  <div class="l-ui-checkbox-container l-ui-mt-lg">
    <input type="checkbox" id="updates" name="updates" value="1">
    <label class="l-ui-label--checkbox" for="updates">Receive product updates</label>
  </div>
</div>

<div class="l-ui-mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-forms-checkboxes-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-forms-checkboxes-heading">Checkboxes</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;div class="l-ui-checkbox-container"&gt;
  &lt;input type="checkbox" id="opt" value="1"&gt;
  &lt;label class="l-ui-label--checkbox" for="opt"&gt;Option&lt;/label&gt;
&lt;/div&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-mt-2xl">Switch inputs</h2>

<div class="l-ui-form__group">
  <label class="l-ui-switch">
    <input type="checkbox" class="l-ui-switch__input" role="switch" checked>
    <span class="l-ui-switch__track"></span>
    Enable notifications
  </label>
</div>

<div class="l-ui-form__group">
  <label class="l-ui-switch">
    <input type="checkbox" class="l-ui-switch__input" role="switch" checked disabled>
    <span class="l-ui-switch__track"></span>
    Disabled (checked)
  </label>
</div>

<div class="l-ui-form__group l-ui-mt-lg">
  <label class="l-ui-switch">
    <input type="checkbox" class="l-ui-switch__input" role="switch">
    <span class="l-ui-switch__track"></span>
    Enable marketing emails
  </label>
</div>

<div class="l-ui-form__group">
  <label class="l-ui-switch">
    <input type="checkbox" class="l-ui-switch__input" role="switch" disabled>
    <span class="l-ui-switch__track"></span>
    Disabled (unchecked)
  </label>
</div>

<div class="l-ui-mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-forms-switch-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-forms-switch-heading">Switch inputs</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;label class="l-ui-switch"&gt;
  &lt;input type="checkbox" class="l-ui-switch__input" role="switch"&gt;
  &lt;span class="l-ui-switch__track"&gt;&lt;/span&gt;
  Enable notifications
&lt;/label&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-mt-2xl">Radio inputs</h2>

<div class="l-ui-form__group l-ui-mt-lg">
  <label class="l-ui-label">Notification frequency</label>
  <div class="l-ui-radio">
    <div class="l-ui-radio__item l-ui-mt-md">
      <input type="radio" id="notify-daily" name="notify" value="daily" class="l-ui-radio__input">
      <label class="l-ui-radio__label" for="notify-daily">Daily</label>
    </div>
    <div class="l-ui-radio__item l-ui-mt-lg">
      <input type="radio" id="notify-weekly" name="notify" value="weekly" class="l-ui-radio__input">
      <label class="l-ui-radio__label" for="notify-weekly">Weekly</label>
    </div>
    <div class="l-ui-radio__item l-ui-mt-lg">
      <input type="radio" id="notify-never" name="notify" value="never" class="l-ui-radio__input">
      <label class="l-ui-radio__label" for="notify-never">Never</label>
    </div>
  </div>
</div>

<div class="l-ui-mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-forms-radio-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-forms-radio-heading">Radio inputs</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;div class="l-ui-radio"&gt;
  &lt;div class="l-ui-radio__item"&gt;
    &lt;input type="radio" class="l-ui-radio__input"&gt;
    &lt;label class="l-ui-radio__label"&gt;Option&lt;/label&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-mt-2xl">Specialised input types</h2>

<p class="l-ui-mt-md">All native HTML5 input types use the same <code>l-ui-form__field</code> class. Date and datetime inputs use the browser's calendar picker, which follows the current light or dark theme.</p>

<form class="l-ui-form l-ui-mt-lg" action="#" method="post">
  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-email">Email address</label>
    <input type="email" id="specialised-email" name="email" class="l-ui-form__field" placeholder="you@example.com" autocomplete="email">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-number">Quantity</label>
    <input type="number" id="specialised-number" name="quantity" class="l-ui-form__field" min="0" step="1" placeholder="0">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-password">Password</label>
    <input type="password" id="specialised-password" name="password" class="l-ui-form__field" autocomplete="new-password">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-url">Website</label>
    <input type="url" id="specialised-url" name="url" class="l-ui-form__field" placeholder="https://example.com">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-tel">Phone</label>
    <input type="tel" id="specialised-tel" name="phone" class="l-ui-form__field" placeholder="+44 00 0000 0000" autocomplete="tel">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-date">Publish on</label>
    <input type="date" id="specialised-date" name="published_on" class="l-ui-form__field">
  </div>

  <div class="l-ui-form__group">
    <label class="l-ui-label" for="specialised-datetime">Publish at</label>
    <input type="datetime-local" id="specialised-datetime" name="published_at" class="l-ui-form__field">
  </div>
</form>

<div class="l-ui-mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-forms-specialised-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-forms-specialised-heading">Specialised input types</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;input type="email" class="l-ui-form__field"&gt;
&lt;input type="number" class="l-ui-form__field" min="0" step="1"&gt;
&lt;input type="password" class="l-ui-form__field"&gt;
&lt;input type="url" class="l-ui-form__field"&gt;
&lt;input type="tel" class="l-ui-form__field"&gt;
&lt;input type="date" class="l-ui-form__field"&gt;
&lt;input type="datetime-local" class="l-ui-form__field"&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-mt-2xl">Action buttons</h2>

<p class="l-ui-mt-md">Use <code>l-ui-form__actions</code> to wrap submit and other action buttons. Buttons are right-aligned on desktop and full-width on mobile.</p>

<form class="l-ui-form l-ui-mt-lg" action="#" method="post">
  <div class="l-ui-form__group">
    <label class="l-ui-label" for="actions-example">Example field</label>
    <input type="text" id="actions-example" name="example" class="l-ui-form__field" placeholder="Some input">
  </div>

  <div class="l-ui-form__actions">
    <button type="submit" class="l-ui-button--primary">
      Save
    </button>
  </div>
</form>

<div class="l-ui-mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-forms-actions-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-forms-actions-heading">Action buttons</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;div class="l-ui-form__actions"&gt;
  &lt;button type="submit" class="l-ui-button--primary"&gt;
    Save
  &lt;/button&gt;
&lt;/div&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-mt-2xl">CSS classes</h2>

<div class="l-ui-table-container l-ui-mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Form CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form</code></th>
        <td class="l-ui-table__cell">Form container</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__group</code></th>
        <td class="l-ui-table__cell">Field group with label and input</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__group--large-gap</code></th>
        <td class="l-ui-table__cell">Group with extra top margin</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__actions</code></th>
        <td class="l-ui-table__cell">Right-aligned action buttons (full-width on mobile)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-label</code></th>
        <td class="l-ui-table__cell">Form label</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__field</code></th>
        <td class="l-ui-table__cell">Text input or textarea</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-select-wrapper</code></th>
        <td class="l-ui-table__cell">Wrapper for select (adds caret icon)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-select</code></th>
        <td class="l-ui-table__cell">Select dropdown</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__hint</code></th>
        <td class="l-ui-table__cell">Help text below input</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__required</code></th>
        <td class="l-ui-table__cell">Required field indicator (*)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__errors</code></th>
        <td class="l-ui-table__cell">Validation errors container</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-form__errors-list</code></th>
        <td class="l-ui-table__cell">List of error messages</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-switch</code></th>
        <td class="l-ui-table__cell">Switch wrapper label</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-switch__input</code></th>
        <td class="l-ui-table__cell">Hidden checkbox input (sr-only)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-switch__track</code></th>
        <td class="l-ui-table__cell">Visible toggle track and thumb</td>
      </tr>
    </tbody>
  </table>
</div>
