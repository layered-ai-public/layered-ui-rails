<h2 class="l-ui-utility--mt-2xl">Collapsible surface</h2>

<details class="l-ui-surface--collapsible l-ui-utility--mt-lg">
  <summary class="l-ui-surface__summary">
    <span>Collapsible heading</span>
    <%= image_tag "layered_ui/icon_chevron_right.svg", alt: "", class: "l-ui-icon--sm l-ui-surface__chevron", aria: { hidden: true } %>
  </summary>
  <div class="l-ui-surface__content">
    <p>
      This content can be toggled open and closed. Uses native HTML
      disclosure for full keyboard and screen reader support.
    </p>
  </div>
</details>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
