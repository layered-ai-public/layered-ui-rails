<%= l_ui_title_bar(
  title: "Icons",
  breadcrumbs: [
    ["Home", root_path]
  ]
) %>

<p class="mt-4">Icon size utilities for consistent scaling across your application.</p>

<h2 class="mt-8 l-ui-heading--section">Icon sizes</h2>

<div class="l-ui-spread mt-4">
  <div>
    <div class="flex h-8 items-center justify-center">
      <%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--xs", aria: { hidden: true } %>
    </div>
    <p class="mt-2">xs (16px)</p>
  </div>
  <div>
    <div class="flex h-8 items-center justify-center">
      <%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
    </div>
    <p class="mt-2">sm (20px)</p>
  </div>
  <div>
    <div class="flex h-8 items-center justify-center">
      <%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--md", aria: { hidden: true } %>
    </div>
    <p class="mt-2">md (24px)</p>
  </div>
  <div>
    <div class="flex h-8 items-center justify-center">
      <%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--lg", aria: { hidden: true } %>
    </div>
    <p class="mt-2">lg (28px)</p>
  </div>
  <div>
    <div class="flex h-8 items-center justify-center">
      <%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--xl", aria: { hidden: true } %>
    </div>
    <p class="mt-2">xl (32px)</p>
  </div>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-icons-sizes-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-icons-sizes-heading">Icon sizes</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--xs", aria: { hidden: true } %&gt;
&lt;%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %&gt;
&lt;%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--md", aria: { hidden: true } %&gt;
&lt;%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--lg", aria: { hidden: true } %&gt;
&lt;%= image_tag "layered_ui/icon_home.svg", alt: "", class: "l-ui-icon l-ui-icon--xl", aria: { hidden: true } %&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">Available icons</h2>

<p class="mt-4">Icons that ship with the gem. Pass the bare name to the <code>icon:</code> argument on <code>l_ui_navigation_item</code> and <code>l_ui_navigation_section</code> (e.g. <code>icon: "globe"</code>), or reference the asset directly as <code>layered_ui/icon_NAME.svg</code>. A name with no matching asset raises <code>Propshaft::MissingAssetError</code>, so only pass a name listed here. To add your own, drop an SVG at <code>app/assets/images/layered_ui/icon_NAME.svg</code> in your app.</p>

<div class="l-ui-spread mt-4">
  <% %w[home globe mail close_circle github discord linkedin x youtube].each do |name| %>
    <div>
      <div class="flex h-8 items-center justify-center">
        <%= image_tag "layered_ui/icon_#{name}.svg", alt: "", class: "l-ui-icon l-ui-icon--md", aria: { hidden: true } %>
      </div>
      <p class="mt-2"><code><%= name %></code></p>
    </div>
  <% end %>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-icons-available-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-icons-available-heading">Available icons</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;%= l_ui_navigation_item("Home", root_path, icon: "home") %&gt;
&lt;%= l_ui_navigation_item("Contact", contact_path, icon: "mail") %&gt;

&lt;%# Or reference the asset directly %&gt;
&lt;%= image_tag "layered_ui/icon_globe.svg", alt: "", class: "l-ui-icon l-ui-icon--md", aria: { hidden: true } %&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">CSS classes</h2>

<div class="l-ui-table-container mt-4">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Icon CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Size</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-icon l-ui-icon--xs</code></th>
        <td class="l-ui-table__cell">16px &times; 16px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-icon l-ui-icon--sm</code></th>
        <td class="l-ui-table__cell">20px &times; 20px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-icon l-ui-icon--md</code></th>
        <td class="l-ui-table__cell">24px &times; 24px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-icon l-ui-icon--lg</code></th>
        <td class="l-ui-table__cell">28px &times; 28px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-icon l-ui-icon--xl</code></th>
        <td class="l-ui-table__cell">32px &times; 32px</td>
      </tr>
    </tbody>
  </table>
</div>
