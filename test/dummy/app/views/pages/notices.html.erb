<%= l_ui_breadcrumbs do %>
  <%= l_ui_breadcrumb_item "Home", root_path %>
<% end %>
<h1>Notices</h1>

<p class="l-ui-utility--mt-md">Flash message styles for success, warning, and error states.</p>

<h2 class="l-ui-utility--mt-2xl">Notice variants</h2>

<div class="l-ui-utility--mt-lg">
  <div class="l-ui-notice--success" role="alert">
    This is a success notice. Everything worked as expected!
  </div>

  <div class="l-ui-notice--warning l-ui-utility--mt-lg" role="alert">
    This is a warning notice. Please review this information carefully.
  </div>

  <div class="l-ui-notice--error l-ui-utility--mt-lg" role="alert">
    This is an error notice. Something went wrong and needs attention.
  </div>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-notices-variants-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-notices-variants-heading">Notice variants</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;div class="l-ui-notice--success"&gt;Success message&lt;/div&gt;
&lt;div class="l-ui-notice--warning"&gt;Warning message&lt;/div&gt;
&lt;div class="l-ui-notice--error"&gt;Error message&lt;/div&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">Rails integration</h2>

<p class="l-ui-utility--mt-md">The layout automatically renders flash messages. Set flash in your controller:</p>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-notices-controller-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-notices-controller-heading">Controller</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code># Success
flash[:notice] = "Record created successfully"
redirect_to @record

# Warning
flash[:warning] = "Please review the changes"

# Error
flash[:alert] = "Something went wrong"</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Notice CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Flash key</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-notice--success</code></th>
        <td class="l-ui-table__cell"><code>:notice</code></td>
        <td class="l-ui-table__cell">Green success message</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-notice--warning</code></th>
        <td class="l-ui-table__cell"><code>:warning</code></td>
        <td class="l-ui-table__cell">Yellow warning message</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-notice--error</code></th>
        <td class="l-ui-table__cell"><code>:alert</code></td>
        <td class="l-ui-table__cell">Red error message</td>
      </tr>
    </tbody>
  </table>
</div>
