<h1>Badges</h1>

<p class="l-ui-utility--mt-md">Status indicators and labels for categorisation.</p>

<h2 class="l-ui-utility--mt-2xl">Badge variants</h2>

<div class="l-ui-container--spread l-ui-utility--mt-lg">
  <span class="l-ui-badge--default">Default</span>
  <span class="l-ui-badge--success">Success</span>
  <span class="l-ui-badge--warning">Warning</span>
  <span class="l-ui-badge--danger">Danger</span>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-badges-variants-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-badges-variants-heading">Badge variants</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;span class="l-ui-badge--default"&gt;Default&lt;/span&gt;
&lt;span class="l-ui-badge--success"&gt;Success&lt;/span&gt;
&lt;span class="l-ui-badge--warning"&gt;Warning&lt;/span&gt;
&lt;span class="l-ui-badge--danger"&gt;Danger&lt;/span&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">Rounded badges</h2>

<div class="l-ui-container--spread l-ui-utility--mt-lg">
  <span class="l-ui-badge--default l-ui-badge--rounded">Default</span>
  <span class="l-ui-badge--success l-ui-badge--rounded">Success</span>
  <span class="l-ui-badge--warning l-ui-badge--rounded">Warning</span>
  <span class="l-ui-badge--danger l-ui-badge--rounded">Danger</span>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-badges-rounded-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-badges-rounded-heading">Rounded badges</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;span class="l-ui-badge--default l-ui-badge--rounded"&gt;Rounded&lt;/span&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Badge CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-badge--default</code></th>
        <td class="l-ui-table__cell">Neutral gray badge</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-badge--success</code></th>
        <td class="l-ui-table__cell">Green success badge</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-badge--warning</code></th>
        <td class="l-ui-table__cell">Yellow warning badge</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-badge--danger</code></th>
        <td class="l-ui-table__cell">Red danger badge</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-badge--rounded</code></th>
        <td class="l-ui-table__cell">Modifier for pill-shaped badges</td>
      </tr>
    </tbody>
  </table>
</div>
