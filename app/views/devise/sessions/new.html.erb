<div class="l-ui-page__vertically-centered">
  <div class="l-ui-page__width-constrained">
    <h1>Login</h1>

    <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), class: 'l-ui-form l-ui-mt-3') do |f| %>
      <%= render 'layered_ui/shared/form_errors', item: resource %>

      <div class="l-ui-form__group">
        <%= render 'layered_ui/shared/label', form: f, field: :email, required: true %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "l-ui-form__field", "aria-describedby": "#{resource_name}_email_error" %>
        <%= render 'layered_ui/shared/field_error', object: resource, field: :email %>
      </div>

      <div class="l-ui-form__group">
        <%= render 'layered_ui/shared/label', form: f, field: :password, required: true %>
        <%= f.password_field :password, autocomplete: "current-password", class: "l-ui-form__field", "aria-describedby": "#{resource_name}_password_error" %>
        <%= render 'layered_ui/shared/field_error', object: resource, field: :password %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="l-ui-form__group l-ui-checkbox-container l-ui-mt-8">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, class: "l-ui-checkbox-container__label" %>
        </div>
      <% end %>

      <div class="l-ui-form__group l-ui-form__group--large-gap">
        <%= f.submit "Continue", class: "l-ui-button l-ui-button--primary l-ui-button--full" %>
      </div>
    <% end %>

    <div class="l-ui-form__group">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
