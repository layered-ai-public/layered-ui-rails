<%= l_ui_breadcrumbs do %>
  <%= l_ui_breadcrumb_item "Layout", layout_path %>
<% end %>
<h1>Breadcrumbs</h1>

<p class="l-ui-utility--mt-md">Display ancestor links above a page title so users can navigate back through a hierarchy. The page title itself serves as the current location, so breadcrumbs contain only links to parent pages.</p>

<h2 class="l-ui-utility--mt-2xl">Basic usage</h2>

<div class="l-ui-utility--mt-lg">
  <%= l_ui_breadcrumbs do %>
    <%= l_ui_breadcrumb_item "Home", root_path %>
    <%= l_ui_breadcrumb_item "Components", buttons_path %>
  <% end %>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button type="button" class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-breadcrumbs-basic-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-breadcrumbs-basic-heading">Basic usage</h3>
      <button type="button" class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;%= l_ui_breadcrumbs do %&gt;
  &lt;%= l_ui_breadcrumb_item "Home", root_path %&gt;
  &lt;%= l_ui_breadcrumb_item "Components", buttons_path %&gt;
&lt;% end %&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">With a title and action</h2>

<div class="l-ui-utility--mt-lg">
  <div class="l-ui-container--spread">
    <div>
      <%= l_ui_breadcrumbs do %>
        <%= l_ui_breadcrumb_item "Home", root_path %>
        <%= l_ui_breadcrumb_item "Buttons", buttons_path %>
      <% end %>
      <h1>Primary</h1>
    </div>
    <button type="button" class="l-ui-button--primary">New</button>
  </div>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button type="button" class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-breadcrumbs-action-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-breadcrumbs-action-heading">With a title and action</h3>
      <button type="button" class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;div class="l-ui-container--spread"&gt;
  &lt;div&gt;
    &lt;%= l_ui_breadcrumbs do %&gt;
      &lt;%= l_ui_breadcrumb_item "Home", root_path %&gt;
      &lt;%= l_ui_breadcrumb_item "Buttons", buttons_path %&gt;
    &lt;% end %&gt;
    &lt;h1&gt;Primary&lt;/h1&gt;
  &lt;/div&gt;
  &lt;button type="button" class="l-ui-button--primary"&gt;New&lt;/button&gt;
&lt;/div&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">Helper reference</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Breadcrumbs helper methods</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Helper</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l_ui_breadcrumbs</code></th>
        <td class="l-ui-table__cell">Wraps breadcrumb items in a <code>&lt;nav&gt;</code> with <code>aria-label="Breadcrumb"</code></td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l_ui_breadcrumb_item(label, path)</code></th>
        <td class="l-ui-table__cell">Renders a linked breadcrumb item with a separator</td>
      </tr>
    </tbody>
  </table>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Breadcrumbs CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-breadcrumbs</code></th>
        <td class="l-ui-table__cell">Wrapper nav element</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-breadcrumbs__list</code></th>
        <td class="l-ui-table__cell">Ordered list containing items</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-breadcrumbs__item</code></th>
        <td class="l-ui-table__cell">Individual breadcrumb item with separator</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-breadcrumbs__link</code></th>
        <td class="l-ui-table__cell">Link styling within breadcrumb items</td>
      </tr>
    </tbody>
  </table>
</div>
