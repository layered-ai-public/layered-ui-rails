      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-message__avatar</code></td>
        <td class="l-ui-table__cell">Circular avatar aligned to bottom of bubble</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-message__bubble</code></td>
        <td class="l-ui-table__cell">Message bubble with background</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-message__author</code></td>
