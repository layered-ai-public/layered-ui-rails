<h1>Surfaces</h1>

<p class="l-ui-utility--mt-md">Container styles for grouping related content with visual hierarchy.</p>

<h2 class="l-ui-utility--mt-2xl">Default surface</h2>

<div class="l-ui-surface l-ui-utility--mt-lg">
  <h3>Surface</h3>
  <p class="l-ui-utility--mt-sm">
    Default surface component with a subtle background and padding.
  </p>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-surfaces-default-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-surfaces-default-heading">Default surface</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;div class="l-ui-surface"&gt;
  &lt;h3&gt;Title&lt;/h3&gt;
  &lt;p&gt;Content goes here&lt;/p&gt;
&lt;/div&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">Active surface</h2>

<div class="l-ui-surface--active l-ui-utility--mt-lg">
