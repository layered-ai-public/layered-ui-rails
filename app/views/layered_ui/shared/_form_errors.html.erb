<% if item.errors.any? %>
  <div id="error_explanation" class="l-ui-form__errors" role="alert">
    <h2>
      <%= pluralize(item.errors.count, "error") %> found:
    </h2>

    <ul class="l-ui-form__errors-list l-ui-mt-4">
      <% item.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
