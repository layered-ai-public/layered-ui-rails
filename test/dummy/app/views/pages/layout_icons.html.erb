<h1>Icons</h1>

<p class="l-ui-utility--mt-md">Icons are used for the header, favicon, apple touch icon, and panel toggle button.</p>
<p class="l-ui-utility--mt-md">Override the defaults by placing files in <code>app/assets/images/layered_ui/</code>.</p>

<h2 class="l-ui-utility--mt-2xl">Files</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table" aria-label="Icon files">
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">File</th>
        <th class="l-ui-table__header-cell" scope="col">Used for</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <td class="l-ui-table__cell--primary"><code>icon_light.svg</code></td>
        <td class="l-ui-table__cell">Header icon and favicon (light theme)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>icon_dark.svg</code></td>
        <td class="l-ui-table__cell">Header icon and favicon (dark theme)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>apple_touch_icon.png</code></td>
        <td class="l-ui-table__cell">Apple touch icon</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>panel_icon_light.svg</code></td>
        <td class="l-ui-table__cell">Panel toggle button (light theme)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>panel_icon_dark.svg</code></td>
        <td class="l-ui-table__cell">Panel toggle button (dark theme)</td>
      </tr>
    </tbody>
  </table>
</div>
