    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;details class="l-ui-surface--collapsible"&gt;
  &lt;summary class="l-ui-surface__summary"&gt;
    &lt;span&gt;Heading text&lt;/span&gt;
    &lt;img src="layered_ui/icon_chevron_right.svg" alt="" class="l-ui-icon--sm l-ui-surface__chevron" aria-hidden="true"&gt;
  &lt;/summary&gt;
  &lt;div class="l-ui-surface__content"&gt;
    &lt;p&gt;Content goes here&lt;/p&gt;
  &lt;/div&gt;
&lt;/details&gt;</code></pre>
    </div>
  </dialog>
</div>

