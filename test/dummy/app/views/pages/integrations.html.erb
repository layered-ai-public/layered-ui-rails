<%= l_ui_title_bar(
  title: "Integrations",
  breadcrumbs: [
    ["Home", root_path]
  ]
) %>

<p class="mt-3">layered-ui-rails works with popular Rails gems out of the box.</p>

<h2 class="mt-8">Supported integrations</h2>

<div class="l-ui-table-container mt-4">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Supported integrations</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Gem</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><%= link_to "Devise", devise_path %></th>
        <td class="l-ui-table__cell">Authentication with styled sign in, registration, and password reset forms</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><%= link_to "Pagy", pagy_path %></th>
        <td class="l-ui-table__cell">Fast pagination with styled navigation controls</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><%= link_to "Ransack", ransack_path %></th>
        <td class="l-ui-table__cell">Search and filtering with styled form controls</td>
      </tr>
    </tbody>
  </table>
</div>
