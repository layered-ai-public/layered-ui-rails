<%
  attribute = config[:attribute]
  extras = (config[:extras] || {}).dup
  extra_class = extras.delete(:class)
  base_opts = {}
  base_opts[:placeholder] = config[:placeholder] if config[:placeholder]
  base_opts[:required] = true if config[:required]

  unless config[:as] == :hidden
    describedby = [l_ui_field_error_id(record, attribute)]
    describedby.unshift(l_ui_field_hint_id(record, attribute)) if config[:hint]
    base_opts["aria-describedby"] = describedby.join(" ")
  end

  field_class = ->(base) { token_list(base, extra_class) }
%>

<% if config[:as] == :hidden %>
  <%= form.hidden_field(attribute, **(extra_class ? { class: extra_class } : {}), **extras) %>
<% elsif config[:as] == :text %>
  <%= form.text_area(attribute, class: field_class.call("l-ui-form__field"),
                     rows: extras.delete(:rows) || 4,
                     **base_opts, **extras) %>
<% elsif config[:as] == :select %>
  <%
    collection = config[:collection]
    choices = collection.respond_to?(:call) ? collection.call : collection
    include_blank = config[:include_blank]
    prompt = config[:prompt]
    include_blank = true if include_blank.nil? && prompt.nil?
    select_options = {}
    select_options[:include_blank] = include_blank unless include_blank.nil?
    select_options[:prompt] = prompt unless prompt.nil?
  %>
  <div class="l-ui-select-container">
    <%= form.select(attribute, choices, select_options,
                    class: field_class.call("l-ui-select"), **base_opts, **extras) %>
  </div>
<% elsif config[:as] == :checkbox %>
  <div class="l-ui-checkbox-container">
    <%= form.check_box(attribute, class: field_class.call("l-ui-checkbox"), **base_opts, **extras) %>
    <%= form.label(attribute, config[:label], class: "l-ui-checkbox-container__label") %>
  </div>
<% else %>
  <%
    method_name = case config[:as]
                  when :string then :text_field
                  when :tel then :telephone_field
                  else :"#{config[:as]}_field"
                  end
  %>
  <%= form.public_send(method_name, attribute,
                       class: field_class.call("l-ui-form__field"), **base_opts, **extras) %>
<% end %>
