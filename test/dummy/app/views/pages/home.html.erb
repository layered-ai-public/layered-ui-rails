<%= l_ui_breadcrumbs do %>
  <%= l_ui_breadcrumb_item "#{gem_spec.name} (v#{gem_spec.version.to_s})" %>
<% end %>
<h1>Home</h1>

<p class="l-ui-utility--mt-md">
  <%= gem_spec.description %>
</p>

<div class="l-ui-container--grid l-ui-utility--mt-lg gap-8">
  <div>
    <div class="flex gap-2 items-start">
      <%= link_to image_tag("light_desktop.webp", alt: "Light theme (desktop)", width: 1436, height: 832, fetchpriority: "high", class: "rounded-sm w-full"), image_path("light_desktop.webp"), target: "_blank", class: "flex-1 min-w-0" %>
      <%= link_to image_tag("light_mobile.webp", alt: "Light theme (mobile)", width: 289, height: 625, fetchpriority: "high", class: "rounded-sm w-full"), image_path("light_mobile.webp"), target: "_blank", class: "w-[21%]" %>
    </div>
    <p class="l-ui-utility--mt-sm"><em>Light theme (desktop and mobile)</em></p>
  </div>

  <div>
    <div class="flex gap-2 items-start">
      <%= link_to image_tag("dark_desktop.webp", alt: "Dark theme (desktop)", width: 1436, height: 836, class: "rounded-sm w-full"), image_path("dark_desktop.webp"), target: "_blank", class: "flex-1 min-w-0" %>
      <%= link_to image_tag("dark_mobile.webp", alt: "Dark theme (mobile)", width: 289, height: 625, class: "rounded-sm w-full"), image_path("dark_mobile.webp"), target: "_blank", class: "w-[21%]" %>
    </div>
    <p class="l-ui-utility--mt-sm"><em>Dark theme (desktop and mobile)</em></p>
  </div>
</div>

<%= render "socials" %>

<h2 class="l-ui-utility--mt-xl">Features</h2>
<div class="l-ui-container--grid l-ui-utility--mt-lg">
  <div class="l-ui-surface">
    <div class="flex items-center gap-2">
      <%= image_tag "icon_sun.svg", class: "l-ui-icon--md", alt: "Sun icon representing dark and light theme support" %>
      <h3>Dark/light theme</h3>
    </div>
    <p class="l-ui-utility--mt-sm">System preference detection with localStorage persistence and manual toggle.</p>
  </div>
  <div class="l-ui-surface">
    <div class="flex items-center gap-2">
      <%= image_tag "icon_device.svg", class: "l-ui-icon--md", alt: "Device icon representing responsive layout" %>
      <h3>Responsive layout</h3>
    </div>
    <p class="l-ui-utility--mt-sm">Header, sidebar navigation, main content area, and optional resizable panel.</p>
  </div>
  <div class="l-ui-surface">
    <div class="flex items-center gap-2">
      <%= image_tag "icon_eye.svg", class: "l-ui-icon--md", alt: "Eye icon representing accessibility compliance" %>
      <h3>WCAG 2.2 AA compliant</h3>
    </div>
    <p class="l-ui-utility--mt-sm">Skip links, focus indicators, ARIA attributes, and 4.5:1 contrast ratios. Read the <%= link_to "latest accessibility audit", "https://github.com/layered-ai-public/layered-ui-rails/blob/main/audits/accessibility/codex-5_3.md", target: "_blank", rel: "noopener noreferrer" %>.</p>
  </div>
  <div class="l-ui-surface">
    <div class="flex items-center gap-2">
      <%= image_tag "icon_puzzle.svg", class: "l-ui-icon--md", alt: "Puzzle piece icon representing optional integrations" %>
      <h3>Optional integrations</h3>
    </div>
    <p class="l-ui-utility--mt-sm"><%= link_to "Devise", devise_path %> authentication, <%= link_to "Pagy", pagy_path %> pagination, and <%= link_to "Ransack", ransack_path %> search and sort with styled controls.</p>
  </div>
  <div class="l-ui-surface">
    <div class="flex items-center gap-2">
      <%= image_tag "icon_paint.svg", class: "l-ui-icon--md", alt: "Paint bucket icon representing customisable branding" %>
      <h3>Customisable branding</h3>
    </div>
    <p class="l-ui-utility--mt-sm">Override the default logos, icons and colors.</p>
  </div>
  <div class="l-ui-surface">
    <div class="flex items-center gap-2">
      <%= image_tag "icon_lighthouse.svg", class: "l-ui-icon--md", alt: "Lighthouse icon representing Google Lighthouse performance" %>
      <h3>Google Lighthouse</h3>
    </div>
    <p class="l-ui-utility--mt-sm"><code>layered-ui-rails</code> scores a <%= link_to "perfect 100", image_path("lighthouse.webp"), target: "_blank" %> across all four Google Lighthouse categories - performance, accessibility, best practices, and SEO.</p>
  </div>
</div>

<h2 class="l-ui-utility--mt-xl">Agent skill</h2>
<p class="l-ui-utility--mt-md">
  An <a href="https://agentskills.io" target="_blank" rel="noopener noreferrer">agent skill</a> is included so AI coding agents can work with <code>layered-ui-rails</code> in your project. Once installed, the agent can handle the full setup - just ask it to add <code>layered-ui-rails</code> to your app and it will install the gem, run the generator, and configure your layout.
</p>
<p class="l-ui-utility--mt-md"><strong>Project install</strong> - scoped to a single repo, available to all contributors:</p>
<pre class="l-ui-surface l-ui-utility--mt-md"><code>bin/rails generate layered:ui:install_agent_skill</code></pre>
<p class="l-ui-utility--mt-md"><strong>Global install</strong> - available across all your projects:</p>
<pre class="l-ui-surface l-ui-utility--mt-md"><code>./install-skill.sh
# or install remotely without cloning the repo:
curl -fsSL https://raw.githubusercontent.com/layered-ai-public/layered-ui-rails/main/install-skill.sh | sh</code></pre>

<h2 class="l-ui-utility--mt-xl">Requirements</h2>
<ul class="l-ui-list l-ui-utility--mt-md">
  <li>Ruby on Rails >= 8.0</li>
  <li>Tailwind CSS Rails >= 4.0</li>
</ul>

<h2 class="l-ui-utility--mt-xl">Installation</h2>
<p class="l-ui-utility--mt-md">Add to your Gemfile:</p>
<pre class="l-ui-surface l-ui-utility--mt-md"><code>gem "layered-ui-rails"</code></pre>
<p class="l-ui-utility--mt-lg">Then run:</p>
<pre class="l-ui-surface l-ui-utility--mt-md"><code>bundle install</code></pre>

<h2 class="l-ui-utility--mt-xl">Setup</h2>
<p class="l-ui-utility--mt-md">Run the install generator to copy CSS and JS to your application:</p>
<pre class="l-ui-surface l-ui-utility--mt-md"><code>bin/rails generate layered:ui:install</code></pre>
<p class="l-ui-utility--mt-lg">This will:</p>
<ul class="l-ui-list l-ui-utility--mt-sm">
  <li>Copy <code>layered_ui.css</code> to <code>app/assets/tailwind/</code></li>
  <li>Add <code>@import "./layered_ui";</code> to your application.css</li>
  <li>Add <code>import "layered_ui"</code> to your application.js</li>
</ul>

<p class="l-ui-utility--mt-lg">Next, update your <code>application.html.erb</code> layout to render the layered-ui-rails layout and set up content blocks for navigation, panels, and page titles. See the <%= link_to "layout guide", layout_path %> for full details.</p>

<p class="l-ui-utility--mt-lg">You can override the default logo by placing your own <code>logo_light.svg</code> and <code>logo_dark.svg</code> files in <code>app/assets/images/layered_ui/</code>. The asset pipeline will serve your files instead of the defaults provided by the engine. The panel button icon color can be changed by overriding the <code>--button-primary-icon</code> Tier 2 token, or replaced entirely by setting <code>@l_ui_panel_icon_light_url</code> and <code>@l_ui_panel_icon_dark_url</code> (rendered in light and dark mode respectively).</p>

<p class="l-ui-utility--mt-lg">See the <%= link_to "integrations page", integrations_path %> for optional Devise, Pagy, and Ransack support.</p>

