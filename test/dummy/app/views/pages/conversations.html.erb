      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-message__metadata</code></td>
        <td class="l-ui-table__cell">Metadata text, left-aligned in footer</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-message__timestamp</code></td>
