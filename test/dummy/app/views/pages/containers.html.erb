<h1>Containers</h1>

<p class="l-ui-utility--mt-md">Layout containers for common page patterns.</p>

<h2 class="l-ui-utility--mt-2xl">Spread container</h2>

<p class="l-ui-utility--mt-md">Flexbox container with title on the left and actions on the right:</p>

<div class="l-ui-container--spread l-ui-utility--mt-lg">
  <h2>Example title</h2>
  <button class="l-ui-button--primary">New</button>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-containers-spread-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-containers-spread-heading">Spread container</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;div class="l-ui-container--spread"&gt;
  &lt;h1&gt;Page title&lt;/h1&gt;
  &lt;button class="l-ui-button--primary"&gt;New&lt;/button&gt;
&lt;/div&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">Grid container</h2>

<p class="l-ui-utility--mt-md">Responsive grid that stacks on mobile and switches to two columns on medium screens:</p>

<div class="l-ui-container--grid l-ui-utility--mt-lg">
  <div class="l-ui-surface">
    <h3>First item</h3>
    <p class="l-ui-utility--mt-sm">Grid items stack vertically on mobile.</p>
  </div>
  <div class="l-ui-surface">
    <h3>Second item</h3>
    <p class="l-ui-utility--mt-sm">On medium screens they sit side by side.</p>
  </div>
  <div class="l-ui-surface">
    <h3>Third item</h3>
    <p class="l-ui-utility--mt-sm">Additional items wrap to the next row.</p>
  </div>
  <div class="l-ui-surface">
    <h3>Fourth item</h3>
    <p class="l-ui-utility--mt-sm">The grid fills evenly with consistent gaps.</p>
  </div>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-containers-grid-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-containers-grid-heading">Grid container</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;div class="l-ui-container--grid"&gt;
  &lt;div class="l-ui-surface"&gt;First&lt;/div&gt;
  &lt;div class="l-ui-surface"&gt;Second&lt;/div&gt;
  &lt;div class="l-ui-surface"&gt;Third&lt;/div&gt;
  &lt;div class="l-ui-surface"&gt;Fourth&lt;/div&gt;
&lt;/div&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption>Container CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-container--spread</code></th>
        <td class="l-ui-table__cell">Flexbox with space-between alignment</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-container--grid</code></th>
        <td class="l-ui-table__cell">Responsive grid, stacked on mobile, two columns on md</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-container--table</code></th>
        <td class="l-ui-table__cell">Scrollable container for <%= link_to "tables", tables_path %></td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-container--checkbox</code></th>
        <td class="l-ui-table__cell">Flexbox container for <%= link_to "checkboxes", forms_path %> and their labels</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-container--pagy</code></th>
        <td class="l-ui-table__cell">Container for <%= link_to "Pagy", pagy_path %> pagination</td>
      </tr>
    </tbody>
  </table>
</div>
