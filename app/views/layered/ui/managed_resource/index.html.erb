<% turbo_frame_name = "managed_#{@managed_route_key}" %>

<h1 class="l-ui-heading"><%= @managed_route_key.humanize %></h1>

<%= turbo_frame_tag turbo_frame_name, data: { turbo_action: "advance" } do %>
  <% if @model.l_ui_managed_search_fields.any? %>
    <%= l_ui_search_form(@q,
          url: send(@managed_url_helper),
          fields: @model.l_ui_managed_search_fields,
          clear: true,
          turbo_frame: turbo_frame_name) %>
  <% end %>

  <%= l_ui_managed_table(@records,
        columns: @columns,
        caption: @managed_route_key.humanize,
        query: @q,
        turbo_frame: turbo_frame_name) %>

  <%= l_ui_pagy(@pagy) %>
<% end %>
