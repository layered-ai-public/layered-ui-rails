<h1>Icons</h1>

<p class="l-ui-utility--mt-md">Icon size utilities for consistent scaling across your application.</p>

<h2 class="l-ui-utility--mt-2xl">Icon sizes</h2>

<div class="l-ui-container--spread l-ui-utility--mt-lg">
  <div>
    <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    <p class="l-ui-utility--mt-sm">sm (20px)</p>
  </div>
  <div>
    <svg class="l-ui-icon--md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    <p class="l-ui-utility--mt-sm">md (24px)</p>
  </div>
  <div>
    <svg class="l-ui-icon--lg" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    <p class="l-ui-utility--mt-sm">lg (28px)</p>
  </div>
  <div>
    <svg class="l-ui-icon--xl" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    <p class="l-ui-utility--mt-sm">xl (32px)</p>
  </div>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-icons-sizes-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-icons-sizes-heading">Icon sizes</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;svg class="l-ui-icon--sm" ...&gt;...&lt;/svg&gt;
&lt;svg class="l-ui-icon--md" ...&gt;...&lt;/svg&gt;
&lt;svg class="l-ui-icon--lg" ...&gt;...&lt;/svg&gt;
&lt;svg class="l-ui-icon--xl" ...&gt;...&lt;/svg&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Icon CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Size</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-icon--sm</code></th>
        <td class="l-ui-table__cell">20px &times; 20px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-icon--md</code></th>
        <td class="l-ui-table__cell">24px &times; 24px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-icon--lg</code></th>
        <td class="l-ui-table__cell">28px &times; 28px</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-icon--xl</code></th>
        <td class="l-ui-table__cell">32px &times; 32px</td>
      </tr>
    </tbody>
  </table>
</div>
