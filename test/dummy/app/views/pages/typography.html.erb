<h2 class="mt-8 l-ui-heading--section">Fonts</h2>

<div class="l-ui-table-container mt-4">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Font family tokens</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Token</th>
        <th class="l-ui-table__header-cell" scope="col">Font stack</th>
        <th class="l-ui-table__header-cell" scope="col">Usage</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>font-manrope</code></th>
        <td class="l-ui-table__cell">Manrope, ui-sans-serif, system-ui, sans-serif</td>
        <td class="l-ui-table__cell">Headings and labels</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>font-inter</code></th>
        <td class="l-ui-table__cell">Inter, ui-sans-serif, system-ui, sans-serif</td>
        <td class="l-ui-table__cell">Body text and form fields</td>
      </tr>
    </tbody>
  </table>
</div>

<h2 class="mt-8 l-ui-heading--section">CSS reference</h2>

<div class="l-ui-table-container mt-4">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Typography CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Element / class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>h1</code></th>
        <td class="l-ui-table__cell">Manrope bold, text-xl</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>h2</code></th>
        <td class="l-ui-table__cell">Manrope bold, text-lg</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-heading--section</code></th>
        <td class="l-ui-table__cell">Opt-in bottom divider for any heading (headings carry no divider by default)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>h3</code></th>
        <td class="l-ui-table__cell">Manrope bold, base size</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>h4</code></th>
        <td class="l-ui-table__cell">Manrope bold, text-sm</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>p</code></th>
        <td class="l-ui-table__cell">Muted foreground, text-sm, relaxed line height</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>p a</code></th>
        <td class="l-ui-table__cell">Foreground color with bottom border underline</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>ul, ol, li</code></th>
        <td class="l-ui-table__cell">Muted foreground, text-sm</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-list</code></th>
        <td class="l-ui-table__cell">Disc bullets, inside position, vertical spacing</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-hr</code></th>
        <td class="l-ui-table__cell">Horizontal rule with theme border and vertical spacing</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>code</code></th>
        <td class="l-ui-table__cell">Muted foreground, text-sm</td>
      </tr>
    </tbody>
  </table>
</div>
