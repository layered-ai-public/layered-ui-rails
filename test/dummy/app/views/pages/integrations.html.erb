<h1>Integrations</h1>

<p class="l-ui-utility--mt-md">layered-ui works with popular Rails gems out of the box.</p>

<h2 class="l-ui-utility--mt-2xl">Supported integrations</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell">Gem</th>
        <th class="l-ui-table__header-cell">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <td class="l-ui-table__cell--primary"><%= link_to "Devise", devise_path %></td>
        <td class="l-ui-table__cell">Authentication with styled sign in, registration, and password reset forms</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><%= link_to "Pagy", pagy_path %></td>
        <td class="l-ui-table__cell">Fast pagination with styled navigation controls</td>
      </tr>
    </tbody>
  </table>
</div>
