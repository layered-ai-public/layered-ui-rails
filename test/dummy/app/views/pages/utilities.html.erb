<h1>Utilities</h1>

<p class="l-ui-utility--mt-md">Responsive utility classes for consistent spacing.</p>

<h2 class="l-ui-utility--mt-2xl">Top margin</h2>

<p class="l-ui-utility--mt-md">Responsive margin utilities that adjust based on screen size:</p>

<div class="l-ui-utility--mt-lg">
  <div class="l-ui-surface">
    <p class="l-ui-utility--mt-sm">l-ui-utility--mt-sm (mt-1 md:mt-2)</p>
  </div>
  <div class="l-ui-surface l-ui-utility--mt-sm">
    <p class="l-ui-utility--mt-md">l-ui-utility--mt-md (mt-2 md:mt-3)</p>
  </div>
  <div class="l-ui-surface l-ui-utility--mt-sm">
    <p class="l-ui-utility--mt-lg">l-ui-utility--mt-lg (mt-3 md:mt-4)</p>
  </div>
  <div class="l-ui-surface l-ui-utility--mt-sm">
    <p class="l-ui-utility--mt-xl">l-ui-utility--mt-xl (mt-4 md:mt-6)</p>
  </div>
  <div class="l-ui-surface l-ui-utility--mt-sm">
    <p class="l-ui-utility--mt-2xl">l-ui-utility--mt-2xl (mt-6 md:mt-8)</p>
  </div>
  <div class="l-ui-surface l-ui-utility--mb-0">
    <p class="l-ui-utility--mb-0">l-ui-utility--mb-0 (mb-0 md:mb-0)</p>
  </div>
</div>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View Code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop">
    <div class="l-ui-modal__header">
      <h3>Utilities</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close">
        <svg class="l-ui-icon--sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <code class="l-ui-surface">&lt;div class="l-ui-utility--mt-sm"&gt;Small margin&lt;/div&gt;
&lt;div class="l-ui-utility--mt-md"&gt;Medium margin&lt;/div&gt;
&lt;div class="l-ui-utility--mt-lg"&gt;Large margin&lt;/div&gt;
&lt;div class="l-ui-utility--mt-xl"&gt;Extra large margin&lt;/div&gt;
&lt;div class="l-ui-utility--mt-2xl"&gt;2X large margin&lt;/div&gt;</code>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell">Class</th>
        <th class="l-ui-table__header-cell">Mobile</th>
        <th class="l-ui-table__header-cell">Desktop (md+)</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-utility--mt-sm</code></td>
        <td class="l-ui-table__cell">0.25rem (mt-1)</td>
        <td class="l-ui-table__cell">0.5rem (mt-2)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-utility--mt-md</code></td>
        <td class="l-ui-table__cell">0.5rem (mt-2)</td>
        <td class="l-ui-table__cell">0.75rem (mt-3)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-utility--mt-lg</code></td>
        <td class="l-ui-table__cell">0.75rem (mt-3)</td>
        <td class="l-ui-table__cell">1rem (mt-4)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-utility--mt-xl</code></td>
        <td class="l-ui-table__cell">1rem (mt-4)</td>
        <td class="l-ui-table__cell">1.5rem (mt-6)</td>
      </tr>
      <tr>
        <td class="l-ui-table__cell--primary"><code>l-ui-utility--mt-2xl</code></td>
        <td class="l-ui-table__cell">1.5rem (mt-6)</td>
        <td class="l-ui-table__cell">2rem (mt-8)</td>
      </tr>
    </tbody>
  </table>
</div>
