<%= l_ui_title_bar(
  title: "Buttons",
  breadcrumbs: [
    ["Home", root_path]
  ]
) %>

<p class="mt-4">Button styles for primary actions, secondary actions, and destructive operations.</p>

<h2 class="mt-8 l-ui-heading--section">Button variants</h2>

<div class="l-ui-spread mt-4">
  <button class="l-ui-button l-ui-button--primary">Primary button</button>
  <button class="l-ui-button l-ui-button--outline">Outline button</button>
  <button class="l-ui-button l-ui-button--danger">Danger button</button>
  <button class="l-ui-button l-ui-button--outline-danger">Outline danger button</button>
  <button class="l-ui-button l-ui-button--icon" aria-label="Close">
    <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
  </button>
  <button class="l-ui-button l-ui-button--icon" aria-label="Toggle dark mode">
    <%= image_tag "layered_ui/icon_moon.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
  </button>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-variants-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-variants-heading">Button variants</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;button class="l-ui-button l-ui-button--primary"&gt;Primary&lt;/button&gt;
&lt;button class="l-ui-button l-ui-button--outline"&gt;Outline&lt;/button&gt;
&lt;button class="l-ui-button l-ui-button--danger"&gt;Danger&lt;/button&gt;
&lt;button class="l-ui-button l-ui-button--outline-danger"&gt;Outline danger&lt;/button&gt;
&lt;button class="l-ui-button l-ui-button--icon" aria-label="Close"&gt;
  &lt;svg class="l-ui-icon l-ui-icon--sm"&gt;...&lt;/svg&gt;
&lt;/button&gt;
&lt;button class="l-ui-button l-ui-button--icon" aria-label="Toggle dark mode"&gt;
  &lt;svg class="l-ui-icon l-ui-icon--sm"&gt;...&lt;/svg&gt;
&lt;/button&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">Disabled</h2>

<div class="l-ui-spread mt-4">
  <button class="l-ui-button l-ui-button--primary" disabled>Primary disabled</button>
  <button class="l-ui-button l-ui-button--outline" disabled>Outline disabled</button>
  <button class="l-ui-button l-ui-button--danger" disabled>Danger disabled</button>
  <button class="l-ui-button l-ui-button--outline-danger" disabled>Outline danger disabled</button>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-disabled-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-disabled-heading">Disabled</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;button class="l-ui-button l-ui-button--primary" disabled&gt;
  Primary disabled
&lt;/button&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">Small</h2>

<p class="mt-4">Compact button for dense areas like header bars. 32px hit area comfortably exceeds the WCAG 2.2 AA 24px target size minimum.</p>

<div class="l-ui-spread mt-4">
  <button class="l-ui-button l-ui-button--primary l-ui-button--small">Primary small</button>
  <button class="l-ui-button l-ui-button--outline l-ui-button--small">Outline small</button>
  <button class="l-ui-button l-ui-button--danger l-ui-button--small">Danger small</button>
  <button class="l-ui-button l-ui-button--outline-danger l-ui-button--small">Outline danger small</button>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-small-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-small-heading">Small</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;button class="l-ui-button l-ui-button--primary l-ui-button--small"&gt;
  Primary small
&lt;/button&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">Small icon button</h2>

<p class="mt-4">Combine <code>l-ui-button--icon</code> with <code>l-ui-button--small</code> for a compact 32px square icon button, useful in dense areas like panel actions or comment toolbars. The 32px hit area comfortably exceeds the WCAG 2.2 AA 24px target size minimum.</p>

<div class="l-ui-spread mt-4">
  <button class="l-ui-button l-ui-button--icon l-ui-button--small" aria-label="Close">
    <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
  </button>
  <button class="l-ui-button l-ui-button--primary l-ui-button--icon l-ui-button--small" aria-label="Toggle dark mode">
    <%= image_tag "layered_ui/icon_moon.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
  </button>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-small-icon-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-small-icon-heading">Small icon button</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;button class="l-ui-button l-ui-button--icon l-ui-button--small" aria-label="Close"&gt;
  &lt;svg class="l-ui-icon l-ui-icon--sm"&gt;...&lt;/svg&gt;
&lt;/button&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">Full width</h2>

<div class="mt-4">
  <button class="l-ui-button l-ui-button--primary l-ui-button--full">Full width button</button>
</div>

<div class="mt-6" data-controller="l-ui--modal">
  <button class="l-ui-button l-ui-button--outline l-ui-button--small" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-buttons-full-width-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-buttons-full-width-heading">Full width</h3>
      <button class="l-ui-button l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;button class="l-ui-button l-ui-button--primary l-ui-button--full"&gt;
  Full width button
&lt;/button&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="mt-8 l-ui-heading--section">CSS classes</h2>

<div class="l-ui-table-container mt-4">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Button CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button--primary</code></th>
        <td class="l-ui-table__cell">Primary action button with solid background (standalone)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button--outline</code></th>
        <td class="l-ui-table__cell">Secondary action button with outline style (standalone)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button--danger</code></th>
        <td class="l-ui-table__cell">Solid red destructive action button (standalone)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button--outline-danger</code></th>
        <td class="l-ui-table__cell">Destructive action button with red outline (standalone)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button l-ui-button--icon</code></th>
        <td class="l-ui-table__cell">Icon-only button for close, theme toggle, and other actions (standalone)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button--full</code></th>
        <td class="l-ui-table__cell">Modifier - combine with a variant above for full-width</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell l-ui-table__cell--primary" scope="row"><code>l-ui-button--small</code></th>
        <td class="l-ui-table__cell">Modifier - combine with a variant above for a compact 32px-tall button</td>
      </tr>
    </tbody>
  </table>
</div>
