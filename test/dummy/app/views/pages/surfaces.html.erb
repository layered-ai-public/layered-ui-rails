<h2 class="l-ui-utility--mt-2xl">Code block</h2>

<pre class="l-ui-surface l-ui-utility--mt-lg"><code>def greet(name)
  "Hello, #{name}!"
end</code></pre>

<div class="l-ui-utility--mt-xl" data-controller="l-ui--modal">
  <button class="l-ui-button--outline" data-action="l-ui--modal#open">View code</button>
  <dialog class="l-ui-modal" data-l-ui--modal-target="dialog" data-action="click->l-ui--modal#closeOnBackdrop" aria-labelledby="modal-surfaces-code-heading">
    <div class="l-ui-modal__header">
      <h3 id="modal-surfaces-code-heading">Code block</h3>
      <button class="l-ui-button--icon" data-action="l-ui--modal#close" aria-label="Close">
        <%= image_tag "layered_ui/icon_close.svg", alt: "", class: "l-ui-icon--sm", aria: { hidden: true } %>
      </button>
    </div>
    <div class="l-ui-modal__body">
      <pre class="l-ui-surface"><code>&lt;pre class="l-ui-surface"&gt;&lt;code&gt;def greet(name)
  "Hello, #{name}!"
end&lt;/code&gt;&lt;/pre&gt;</code></pre>
    </div>
  </dialog>
</div>

<h2 class="l-ui-utility--mt-2xl">CSS classes</h2>

<div class="l-ui-container--table l-ui-utility--mt-lg">
  <table class="l-ui-table">
    <caption class="l-ui-sr-only">Surface CSS classes</caption>
    <thead class="l-ui-table__header">
      <tr>
        <th class="l-ui-table__header-cell" scope="col">Class</th>
        <th class="l-ui-table__header-cell" scope="col">Description</th>
      </tr>
    </thead>
    <tbody class="l-ui-table__body">
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface</code></th>
        <td class="l-ui-table__cell">Default surface with background</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface--highlighted</code></th>
        <td class="l-ui-table__cell">Highlighted state</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface--collapsible</code></th>
        <td class="l-ui-table__cell">Collapsible surface with disclosure toggle (use on <code>&lt;details&gt;</code>)</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface--collapsible-highlighted</code></th>
        <td class="l-ui-table__cell">Visual color variant of collapsible surface (uses <code>bg-surface-highlighted</code>), not an open-state modifier</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface__summary</code></th>
        <td class="l-ui-table__cell">Summary/heading row inside a collapsible surface</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface--sm</code></th>
        <td class="l-ui-table__cell">Compact variant with smaller padding and summary text</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface__chevron</code></th>
        <td class="l-ui-table__cell">Disclosure chevron icon that rotates when open</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>l-ui-surface__content</code></th>
        <td class="l-ui-table__cell">Content area inside a collapsible surface</td>
      </tr>
      <tr>
        <th class="l-ui-table__cell--primary" scope="row"><code>pre.l-ui-surface</code></th>
        <td class="l-ui-table__cell">Preformatted code block</td>
      </tr>
    </tbody>
  </table>
</div>
